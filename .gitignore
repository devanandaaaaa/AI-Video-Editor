# Private configuration: never commit API keys or other secrets.
.env
.env.*
!.env.example

# Python environment and cache files.
backend/.venv/
backend/__pycache__/
backend/**/*.py[cod]

# Dependencies generated for the React frontend.
frontend/node_modules/
frontend/dist/

# Large and temporary video-processing files.
backend/uploads/
backend/outputs/
backend/chroma_data/
backend/app.db

# Editor and operating-system files.
.vscode/
.DS_Store
Thumbs.db
debug.log
